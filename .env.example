# ==========================================================================
# HRIA — Referencia de variables de entorno.
#
# ⚠️ IMPORTANTE: la aplicación NO lee este archivo (ni ningún ".env").
#    Es solo una LISTA DE REFERENCIA de las variables que existen.
#    Debes definirlas en el sistema o en la configuración del servicio:
#      · IIS/Windows  -> web.config <environmentVariables>, o variables de máquina
#      · Linux        -> EnvironmentFile del servicio systemd
#      · Desarrollo   -> no hace falta nada (SQLite) o "dotnet user-secrets"
#    Ver docs/deployment-sqlserver.md, sección "¿Dónde se definen estas variables?"
#
# Nombres según la configuración de ASP.NET Core: el doble guion bajo "__"
# representa la jerarquía de secciones (Jwt__Secret == Jwt:Secret).
# NUNCA subas valores reales al repositorio.
#
# En DESARROLLO no necesitas nada de esto: la app usa SQLite y genera un
# secreto JWT efímero automáticamente.
# ==========================================================================

# --- Entorno y escucha ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# --- Base de datos ---
# Provider: "SqlServer" (producción) o "Sqlite" (demo, sin dependencias).
Database__Provider=SqlServer
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=HRIA;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=False
# Alternativa con SQLite:
# Database__Provider=Sqlite
# ConnectionStrings__DefaultConnection=Data Source=hria.db

# --- Seguridad (JWT) ---
# Secreto de firma. Genera uno largo y aleatorio (>= 32 bytes).
# Ejemplo:  openssl rand -base64 48
# OBLIGATORIO en producción: la API no arranca si está vacío.
Jwt__Secret=CHANGE_ME_use_a_long_random_secret_min_32_chars
Jwt__Issuer=HRIA
Jwt__Audience=HRIA.Client
Jwt__ExpiresMinutes=60

# --- CORS: orígenes permitidos (URL pública del frontend) ---
Cors__AllowedOrigins__0=http://localhost:5173

# --- Asistente de IA (opcional) ---
# Si se deja vacío, el asistente funciona en MODO DEMO (respuestas controladas).
OpenAI__ApiKey=
OpenAI__Model=gpt-4o-mini

# --- Datos de demostración ---
# true: siembra departamentos, empleados y jornadas de ejemplo al arrancar.
Demo__Enabled=true

# --- Frontend (build) ---
# URL pública de la API para compilar la SPA (frontend/.env o variable de build).
# VITE_API_BASE_URL=https://tu-api.example.com/api
